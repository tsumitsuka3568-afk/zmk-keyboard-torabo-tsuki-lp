#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define L_WIN_US_BASE     0
#define L_WIN_US_SYMBOLS  1
#define L_WIN_US_FN       2
#define L_WIN_JIS_BASE    3
#define L_WIN_JIS_SYMBOLS 4
#define L_WIN_JIS_FN      5
#define L_MAC_BASE        6
#define L_MAC_SYMBOLS     7
#define L_MAC_FN          8
#define L_DEVICE          9
#define L_MOUSE          10
#define L_SCROLL         11

/ {
    behaviors {
        jis_semi_colon: jis_semi_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "JIS ; / :";
            bindings = <&kp SEMI>, <&kp SINGLE_QUOTE>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    macros {
        jis_yen: jis_yen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "JIS Yen";
            bindings = <&kp INT_YEN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_us_base {
            display-name = "Win US Base";
            bindings = <
&none  &none      &none     &none     &none              &none                                      &none          &none  &none      &none     &none                 &none
&none  &kp Q      &kp W     &kp E     &kp R              &kp T                                      &kp Y          &kp U  &kp I      &kp O     &kp P                 &none
&none  &kp A      &kp S     &kp D     &kp F              &kp G          &none          &none        &kp H          &kp J  &kp K      &kp L     &kp SEMI              &none
&none  &kp Z      &kp X     &kp C     &kp V              &kp B          &kp SPACE      &kp RET      &kp N          &kp M  &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL  &kp LGUI  &kp LALT  &lt L_MOUSE TAB    &lt L_WIN_US_SYMBOLS SPACE  &kp SPACE  &lt L_WIN_US_FN ENTER  &kp BACKSPACE  &none  &none  &kp RGUI  &kp RCTRL  &none
            >;
        };

        win_us_symbols {
            display-name = "Win US Symbols";
            bindings = <
&none  &none            &none            &none      &none      &none                                &none          &none         &none            &none             &none         &none
&none  &kp LS(NUMBER_1) &kp LS(NUMBER_2) &kp LS(N3) &kp LS(N4) &kp LS(N5)                           &kp LS(N6)     &kp LS(N7)    &kp LS(N8)       &kp LS(N9)        &kp LS(N0)    &none
&none  &kp N1           &kp N2           &kp N3     &kp N4     &kp N5       &none       &none        &kp LEFT_BRACE &kp MINUS     &kp EQUAL         &kp RIGHT_BRACE   &kp COLON     &none
&none  &kp N6           &kp N7           &kp N8     &kp N9     &kp N0       &trans      &trans       &kp LS(MINUS)  &kp LS(EQUAL) &kp LEFT_BRACKET  &kp RIGHT_BRACKET &kp BACKSLASH &none
&none  &trans           &trans           &trans     &trans     &trans       &trans      &trans       &kp TAB        &none         &none              &trans             &trans         &none
            >;
        };

        win_us_fn {
            display-name = "Win US Fn";
            bindings = <
&none  &none    &none    &none    &none       &none                                &none             &none       &none          &none       &none       &none
&none  &kp F1   &kp F2   &kp F3   &kp F4      &kp F5                               &kp HOME          &kp PG_UP  &kp PAGE_DOWN &kp END     &kp ESCAPE &none
&none  &kp F6   &kp F7   &kp F8   &kp F9      &kp F10      &none      &none        &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT   &kp TAB    &none
&none  &kp F11  &kp F12  &trans   &trans      &trans        &trans     &trans       &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE   &kp PIPE   &none
&none  &to L_DEVICE &trans &trans  &kp DELETE  &kp TAB       &trans     &trans       &trans            &none      &none          &trans       &trans      &none
            >;
        };

        win_jis_base {
            display-name = "Win JIS Base";
            bindings = <
&none  &none      &none     &none     &none              &none                                      &none          &none  &none      &none     &none                 &none
&none  &kp Q      &kp W     &kp E     &kp R              &kp T                                      &kp Y          &kp U  &kp I      &kp O     &kp P                 &none
&none  &kp A      &kp S     &kp D     &kp F              &kp G          &none          &none        &kp H          &kp J  &kp K      &kp L     &jis_semi_colon       &none
&none  &kp Z      &kp X     &kp C     &kp V              &kp B          &kp SPACE      &kp RET      &kp N          &kp M  &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL  &kp LGUI  &kp LALT  &lt L_MOUSE TAB    &lt L_WIN_JIS_SYMBOLS SPACE  &kp SPACE  &lt L_WIN_JIS_FN ENTER  &kp BACKSPACE  &none  &none  &kp RGUI  &kp RCTRL  &none
            >;
        };

        win_jis_symbols {
            display-name = "Win JIS Symbols";
            bindings = <
&none  &none        &none             &none       &none       &none                                      &none                &none                    &none                  &none          &none          &none
&none  &kp LS(N1)   &kp LEFT_BRACKET  &kp LS(N3) &kp LS(N4) &kp LS(N5)                                 &kp EQUAL           &kp LS(N6)              &kp LS(SINGLE_QUOTE) &kp LS(N8)     &kp LS(N9)     &none
&none  &kp N1       &kp N2            &kp N3     &kp N4     &kp N5          &none         &none          &kp LS(RIGHT_BRACKET) &kp MINUS              &kp LS(MINUS)         &kp PIPE           &kp SINGLE_QUOTE &none
&none  &kp N6       &kp N7            &kp N8     &kp N9     &kp N0          &trans        &trans         &kp LS(INTERNATIONAL_1) &kp LS(SEMICOLON)  &kp RIGHT_BRACKET     &kp BACKSLASH      &kp INTERNATIONAL_1 &none
&none  &trans       &trans            &trans     &trans     &trans          &trans        &trans         &kp TAB             &none                    &none                  &trans          &trans          &none
            >;
        };

        win_jis_fn {
            display-name = "Win JIS Fn";
            bindings = <
&none  &none    &none    &none    &none       &none                                &none       &none       &none                 &none          &none                    &none
&none  &kp F1   &kp F2   &kp F3   &kp F4      &kp F5                               &kp HOME    &kp PG_UP  &kp PAGE_DOWN         &kp END        &kp ESCAPE              &none
&none  &kp F6   &kp F7   &kp F8   &kp F9      &kp F10      &none      &none        &kp LEFT    &kp DOWN   &kp UP_ARROW           &kp RIGHT      &kp TAB                 &none
&none  &kp F11  &kp F12  &trans   &trans      &jis_yen     &trans     &trans       &kp LS(N7)  &kp LS(N2) &kp LS(LEFT_BRACKET)  &kp LS(EQUAL) &kp LS(INTERNATIONAL_3) &none
&none  &to L_DEVICE &trans &trans  &kp DELETE  &kp TAB      &trans     &trans       &trans      &none       &none                 &trans         &trans                    &none
            >;
        };

        mac_base {
            display-name = "Mac Base";
            bindings = <
&none  &none      &none     &none     &none              &none                                      &none          &none  &none      &none     &none                 &none
&none  &kp Q      &kp W     &kp E     &kp R              &kp T                                      &kp Y          &kp U  &kp I      &kp O     &kp P                 &none
&none  &kp A      &kp S     &kp D     &kp F              &kp G          &none          &none        &kp H          &kp J  &kp K      &kp L     &kp SEMI              &none
&none  &kp Z      &kp X     &kp C     &kp V              &kp B          &kp SPACE      &kp RET      &kp N          &kp M  &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH  &none
&none  &kp LCTRL  &kp LGUI  &kp LALT  &lt L_MOUSE TAB    &lt L_MAC_SYMBOLS SPACE  &kp SPACE  &lt L_MAC_FN ENTER  &kp BACKSPACE  &none  &none  &kp RGUI  &kp RCTRL  &none
            >;
        };

        mac_symbols {
            display-name = "Mac Symbols";
            bindings = <
&none  &none            &none            &none      &none      &none                                &none          &none         &none            &none             &none         &none
&none  &kp LS(NUMBER_1) &kp LS(NUMBER_2) &kp LS(N3) &kp LS(N4) &kp LS(N5)                           &kp LS(N6)     &kp LS(N7)    &kp LS(N8)       &kp LS(N9)        &kp LS(N0)    &none
&none  &kp N1           &kp N2           &kp N3     &kp N4     &kp N5       &none       &none        &kp LEFT_BRACE &kp MINUS     &kp EQUAL         &kp RIGHT_BRACE   &kp COLON     &none
&none  &kp N6           &kp N7           &kp N8     &kp N9     &kp N0       &trans      &trans       &kp LS(MINUS)  &kp LS(EQUAL) &kp LEFT_BRACKET  &kp RIGHT_BRACKET &kp BACKSLASH &none
&none  &trans           &trans           &trans     &trans     &trans       &trans      &trans       &kp TAB        &none         &none              &trans             &trans         &none
            >;
        };

        mac_fn {
            display-name = "Mac Fn";
            bindings = <
&none  &none    &none    &none    &none       &none                                &none             &none       &none          &none       &none       &none
&none  &kp F1   &kp F2   &kp F3   &kp F4      &kp F5                               &kp HOME          &kp PG_UP  &kp PAGE_DOWN &kp END     &kp ESCAPE &none
&none  &kp F6   &kp F7   &kp F8   &kp F9      &kp F10      &none      &none        &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT   &kp TAB    &none
&none  &kp F11  &kp F12  &trans   &trans      &trans        &trans     &trans       &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE   &kp PIPE   &none
&none  &to L_DEVICE &trans &trans  &kp DELETE  &kp TAB       &trans     &trans       &trans            &none      &none          &trans       &trans      &none
            >;
        };

        device {
            display-name = "Device";
            bindings = <
&none  &none         &none         &none         &none         &none                            &none   &none   &none   &none   &none       &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                     &trans  &trans  &trans  &trans  &bt BT_CLR &none
&none  &to L_WIN_US_BASE &to L_WIN_JIS_BASE &to L_MAC_BASE &trans &trans  &none   &none        &trans  &trans  &trans  &trans  &trans      &none
&none  &out OUT_USB  &out OUT_BLE  &trans       &trans       &trans       &trans  &trans       &trans  &trans  &trans  &trans  &trans      &none
&none  &trans        &trans        &trans       &trans       &trans       &trans  &trans       &trans  &none   &none   &trans  &trans      &none
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&none  &none   &none   &none      &none      &none                         &none   &none      &none      &none      &none   &none
&none  &trans  &trans  &trans     &trans     &trans                        &trans  &trans     &trans     &trans     &trans  &none
&none  &trans  &trans  &mkp RCLK &mkp LCLK &mo L_SCROLL  &none   &none    &trans  &mkp LCLK &mkp MCLK &mkp RCLK &trans  &none
&none  &trans  &trans  &trans     &trans     &trans        &trans  &trans   &trans  &trans     &trans     &trans     &trans  &none
&none  &trans  &trans  &trans     &trans     &trans        &trans  &trans   &trans  &none      &none      &trans     &trans  &none
            >;
        };

        scroll {
            display-name = "Scroll";
            bindings = <
&none  &none   &none   &none   &none   &none                       &none   &none   &none   &none   &none   &none
&none  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none      &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &none   &none   &trans  &trans  &none
            >;
        };
    };
};

